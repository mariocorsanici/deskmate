#!/usr/bin/env python3
"""Stable command-line interface for Deskmate."""

from __future__ import annotations

import json
import pathlib
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parent.parent
COMMANDS = {
    "check": [sys.executable, "-I", str(ROOT / "tools" / "check.py")],
    "sessions": [sys.executable, "-I", str(ROOT / "tools" / "sessions.py")],
    "session-stats": [sys.executable, "-I", str(ROOT / "tools" / "session_stats.py")],
    "reminders": [sys.executable, "-I", str(ROOT / "tools" / "reminders.py")],
    "open-session": ["/bin/zsh", str(ROOT / "tools" / "open_tab.sh")],
    "log-event": ["/bin/zsh", str(ROOT / "tools" / "log_event.sh")],
    "token-usage": [sys.executable, "-I", str(ROOT / "tools" / "token_usage.py")],
}
DESCRIPTIONS = {
    "check": "run the Checks in Project cards",
    "sessions": "summarize Claude Work sessions",
    "session-stats": "report the resume/new-session experiment",
    "reminders": "validate or render reminders",
    "open-session": "open or resume a Claude Work session",
    "log-event": "append a Daily loop event",
    "token-usage": "update usage for logged skill runs",
}


def write_json(command: str | None, returncode: int, stdout: str, stderr: str) -> None:
    print(json.dumps({
        "schema_version": 1,
        "ok": returncode == 0,
        "command": command,
        "exit_code": returncode,
        "stdout": stdout,
        "stderr": stderr,
    }, sort_keys=True))


def write_help() -> None:
    print("usage: deskmate [--json] <command> [arguments]")
    print("\ncommands:")
    for name, description in DESCRIPTIONS.items():
        print(f"  {name:<16}{description}")


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if args == ["--help"] or args == ["-h"]:
        write_help()
        return 0
    json_output = bool(args and args[0] == "--json")
    if json_output:
        args.pop(0)
    if not args or args[0] not in COMMANDS:
        command = args[0] if args else None
        error = f"unknown command: {command}\n" if command else "command required\n"
        if json_output:
            write_json(command, 2, "", error)
        else:
            print(error, end="", file=sys.stderr)
            print("run 'deskmate --help' for available commands", file=sys.stderr)
        return 2

    command = args[0]
    completed = subprocess.run(
        [*COMMANDS[command], *args[1:]],
        capture_output=True,
        text=True,
        check=False,
    )
    if json_output:
        write_json(command, completed.returncode, completed.stdout, completed.stderr)
        return completed.returncode
    sys.stdout.write(completed.stdout)
    sys.stderr.write(completed.stderr)
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
