#!/usr/bin/env python3
"""Stable command-line interface for Deskmate."""

from __future__ import annotations

import json
import os
import pathlib
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parent.parent
COMMANDS = {
    "setup": [sys.executable, "-I", str(ROOT / "tools" / "installation.py"), "setup"],
    "remove": [sys.executable, "-I", str(ROOT / "tools" / "installation.py"), "remove"],
    "transfer-read": [sys.executable, "-I", str(ROOT / "tools" / "transfers.py"), "read"],
    "transfer-cleanup": [sys.executable, "-I", str(ROOT / "tools" / "transfers.py"), "cleanup"],
    "switch": [sys.executable, "-I", str(ROOT / "tools" / "provider_switch.py")],
    "session-delta": [sys.executable, "-I", str(ROOT / "tools" / "session_delta.py")],
    "work-session": [sys.executable, "-I", str(ROOT / "tools" / "work_sessions.py")],
    "integration": [sys.executable, "-I", str(ROOT / "tools" / "adapter_cli.py"), "integration"],
    "provider-launch": [sys.executable, "-I", str(ROOT / "tools" / "adapter_cli.py"), "provider-launch"],
    "session": [sys.executable, "-I", str(ROOT / "tools" / "adapter_cli.py"), "session"],
    "card": [sys.executable, "-I", str(ROOT / "tools" / "project_cards.py")],
    "check": [sys.executable, "-I", str(ROOT / "tools" / "check.py")],
    "sessions": [sys.executable, "-I", str(ROOT / "tools" / "adapter_cli.py"), "sessions"],
    "session-stats": [sys.executable, "-I", str(ROOT / "tools" / "session_stats.py")],
    "reminders": [sys.executable, "-I", str(ROOT / "tools" / "reminders.py")],
    "open-session": ["/bin/zsh", str(ROOT / "tools" / "open_tab.sh")],
    "log-event": [sys.executable, "-I", str(ROOT / "tools" / "activity_log.py"), "event"],
    "metrics": [sys.executable, "-I", str(ROOT / "tools" / "metrics.py")],
    "hook-event": [sys.executable, "-I", str(ROOT / "tools" / "hook_event.py")],
    "log-migrate": [sys.executable, "-I", str(ROOT / "tools" / "activity_log.py"), "migrate"],
    "token-usage": [sys.executable, "-I", str(ROOT / "tools" / "token_usage.py")],
    "providers": [sys.executable, "-I", str(ROOT / "tools" / "providers.py"), "providers"],
    "configure": [sys.executable, "-I", str(ROOT / "tools" / "providers.py"), "configure"],
}
DESCRIPTIONS = {
    "setup": "install compatible Providers and migrate shared data with backups",
    "remove": "remove integrations, preserving personal data unless explicitly purged",
    "transfer-read": "consume a private transfer for its target Provider",
    "transfer-cleanup": "remove expired managed transfer bundles",
    "switch": "explicitly continue a Project in a new target Provider session",
    "session-delta": "read bounded conversation after a saved Checkpoint",
    "work-session": "continue a Project with its recorded Provider or explicitly start anew",
    "integration": "configure Provider hooks and shared skills",
    "provider-launch": "launch or resume a Provider Work session",
    "session": "read one Provider Work session",
    "card": "locate, list, write or migrate shared Project cards",
    "check": "run the Checks in Project cards",
    "sessions": "summarize Claude Work sessions",
    "session-stats": "report the resume/new-session experiment",
    "reminders": "validate or render reminders",
    "open-session": "open or resume a Claude Work session",
    "log-event": "append a Provider-owned Daily loop event",
    "metrics": "report separate Provider activity and raw usage",
    "hook-event": "record native Provider hook activity",
    "log-migrate": "migrate historical activity logs with a backup",
    "token-usage": "update usage for logged skill runs",
    "providers": "detect compatible local Providers",
    "configure": "record installed and Default providers",
}
USAGE = {
    "setup": "deskmate setup [--provider claude|codex]... [--default-provider claude|codex] [--non-interactive] [--project PATH]... [--name NAME] [--language LANGUAGE]",
    "remove": "deskmate remove [--non-interactive] [--purge-data]",
    "transfer-read": "deskmate transfer-read --bundle PATH --provider claude|codex",
    "transfer-cleanup": "deskmate transfer-cleanup",
    "switch": "deskmate switch --folder PATH --to claude|codex [--preview]",
    "session-delta": "deskmate session-delta --provider claude|codex --session-id ID [--after ISO_TIMESTAMP] [--max-messages N] [--max-characters N] [--format text|json]",
    "work-session": "deskmate work-session --folder PATH [--new [--provider claude|codex]] [--title TEXT] [--prompt TEXT] [--dry-run]",
    "integration": "deskmate integration --provider claude|codex [--remove] [--verify]",
    "provider-launch": "deskmate provider-launch --provider claude|codex --folder PATH [--session-id ID] [--prompt TEXT] [--dry-run]",
    "session": "deskmate session --provider claude|codex --session-id ID",
    "card": "deskmate card <locate|list|write|migrate> [arguments]",
    "check": "deskmate check [--all] [card ...]",
    "sessions": "deskmate sessions [--since DATE] [--messages N] [--cut N]",
    "session-stats": "deskmate session-stats [--since DATE]",
    "reminders": "deskmate reminders <check|text|window|plist|ics|respond> [kind] [answer] [--provider claude|codex] [--with-provider]",
    "open-session": "deskmate open-session [--new] <title> <folder> <session-or-prompt>",
    "log-event": "deskmate log-event <event> [detail] [session] [cwd] [--provider claude|codex]",
    "metrics": "deskmate metrics [--provider claude|codex|all] [--since DATE]",
    "hook-event": "deskmate hook-event --provider claude|codex < native-hook.json",
    "log-migrate": "deskmate log-migrate",
    "token-usage": "deskmate token-usage [--session ID] [--projects DIRECTORY]",
    "providers": "deskmate providers",
    "configure": "deskmate configure [--non-interactive] [--default-provider claude|codex]",
}


def write_json(command: str | None, returncode: int, stdout: str, stderr: str) -> None:
    print(json.dumps({
        "schema_version": 1,
        "ok": returncode == 0,
        "command": command,
        "exit_code": returncode,
        "stdout": stdout,
        "stderr": stderr,
    }, sort_keys=True))


def help_text() -> str:
    lines = ["usage: deskmate [--json] <command> [arguments]", "", "commands:"]
    for name, description in DESCRIPTIONS.items():
        lines.append(f"  {name:<16}{description}")
    return "\n".join(lines) + "\n"


def command_help_text(command: str) -> str:
    return f"usage: {USAGE[command]}\n\n{DESCRIPTIONS[command]}\n"


def cleanup_transfers(command, args):
    # Preview/delta inspection and explicit dry runs keep their read-only contract.
    if (command in ('setup', 'remove', 'switch', 'session-delta', 'transfer-read', 'transfer-cleanup')
            or any(flag in args for flag in ('--preview', '--dry-run', '--help', '-h'))
            or os.environ.get('DESKMATE_DRY_RUN')):
        return ''
    directory = pathlib.Path(os.environ.get('DESKMATE_DATA_DIR', ROOT / 'data')).expanduser() / 'transfers'
    if not directory.exists() and not directory.is_symlink():
        return ''
    result = subprocess.run(COMMANDS['transfer-cleanup'], capture_output=True, text=True, check=False)
    return 'warning: expired transfer cleanup could not be completed\n' if result.returncode else ''


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    json_output = bool(args and args[0] == "--json")
    if json_output:
        args.pop(0)
    if args in (["--help"], ["-h"]):
        output = help_text()
        if json_output:
            write_json(None, 0, output, "")
        else:
            sys.stdout.write(output)
        return 0
    if len(args) == 2 and args[0] in COMMANDS and args[1] in ("--help", "-h"):
        output = command_help_text(args[0])
        if json_output:
            write_json(args[0], 0, output, "")
        else:
            sys.stdout.write(output)
        return 0
    if not args or args[0] not in COMMANDS:
        command = args[0] if args else None
        error = f"unknown command: {command}\n" if command else "command required\n"
        if json_output:
            write_json(command, 2, "", error)
        else:
            print(error, end="", file=sys.stderr)
            print("run 'deskmate --help' for available commands", file=sys.stderr)
        return 2

    command = args[0]
    invocation = [*COMMANDS[command], *args[1:]]
    if json_output and command in ("work-session", "session-delta", "switch"):
        invocation.append("--format=json")
    if not json_output:
        code = subprocess.run(invocation, check=False).returncode
        if code == 0:
            sys.stderr.write(cleanup_transfers(command, args[1:]))
        return code

    completed = subprocess.run(
        invocation,
        capture_output=True,
        text=True,
        check=False,
    )
    warning = cleanup_transfers(command, args[1:]) if completed.returncode == 0 else ''
    write_json(command, completed.returncode, completed.stdout, completed.stderr + warning)
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
