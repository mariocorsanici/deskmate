#!/usr/bin/env python3
"""Stable command-line interface for Deskmate."""

from __future__ import annotations

import json
import pathlib
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parent.parent
COMMANDS = {
    "check": [sys.executable, "-I", str(ROOT / "tools" / "check.py")],
    "sessions": [sys.executable, "-I", str(ROOT / "tools" / "sessions.py")],
    "session-stats": [sys.executable, "-I", str(ROOT / "tools" / "session_stats.py")],
    "reminders": [sys.executable, "-I", str(ROOT / "tools" / "reminders.py")],
    "open-session": ["/bin/zsh", str(ROOT / "tools" / "open_tab.sh")],
    "log-event": ["/bin/zsh", str(ROOT / "tools" / "log_event.sh")],
    "token-usage": [sys.executable, "-I", str(ROOT / "tools" / "token_usage.py")],
}
DESCRIPTIONS = {
    "check": "run the Checks in Project cards",
    "sessions": "summarize Claude Work sessions",
    "session-stats": "report the resume/new-session experiment",
    "reminders": "validate or render reminders",
    "open-session": "open or resume a Claude Work session",
    "log-event": "append a Daily loop event",
    "token-usage": "update usage for logged skill runs",
}
USAGE = {
    "check": "deskmate check [--all] [card ...]",
    "sessions": "deskmate sessions [--since DATE] [--messages N] [--cut N]",
    "session-stats": "deskmate session-stats [--since DATE]",
    "reminders": "deskmate reminders <check|text|window|plist|ics> [kind]",
    "open-session": "deskmate open-session [--new] <title> <folder> <session-or-prompt>",
    "log-event": "deskmate log-event <event> [detail] [session] [cwd]",
    "token-usage": "deskmate token-usage [--session ID] [--projects DIRECTORY]",
}


def write_json(command: str | None, returncode: int, stdout: str, stderr: str) -> None:
    print(json.dumps({
        "schema_version": 1,
        "ok": returncode == 0,
        "command": command,
        "exit_code": returncode,
        "stdout": stdout,
        "stderr": stderr,
    }, sort_keys=True))


def help_text() -> str:
    lines = ["usage: deskmate [--json] <command> [arguments]", "", "commands:"]
    for name, description in DESCRIPTIONS.items():
        lines.append(f"  {name:<16}{description}")
    return "\n".join(lines) + "\n"


def command_help_text(command: str) -> str:
    return f"usage: {USAGE[command]}\n\n{DESCRIPTIONS[command]}\n"


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    json_output = bool(args and args[0] == "--json")
    if json_output:
        args.pop(0)
    if args in (["--help"], ["-h"]):
        output = help_text()
        if json_output:
            write_json(None, 0, output, "")
        else:
            sys.stdout.write(output)
        return 0
    if len(args) == 2 and args[0] in COMMANDS and args[1] in ("--help", "-h"):
        output = command_help_text(args[0])
        if json_output:
            write_json(args[0], 0, output, "")
        else:
            sys.stdout.write(output)
        return 0
    if not args or args[0] not in COMMANDS:
        command = args[0] if args else None
        error = f"unknown command: {command}\n" if command else "command required\n"
        if json_output:
            write_json(command, 2, "", error)
        else:
            print(error, end="", file=sys.stderr)
            print("run 'deskmate --help' for available commands", file=sys.stderr)
        return 2

    command = args[0]
    invocation = [*COMMANDS[command], *args[1:]]
    if not json_output:
        return subprocess.run(invocation, check=False).returncode

    completed = subprocess.run(
        invocation,
        capture_output=True,
        text=True,
        check=False,
    )
    write_json(command, completed.returncode, completed.stdout, completed.stderr)
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
